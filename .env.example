# BotChain AI backend — copy to .env and fill in real values. Never commit .env.
# The backend MUST use the direct (unpooled) Neon URL, not the pooled one the frontend uses.

# Postgres (Neon, direct/unpooled)
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Kinde — issuer from the Kinde app dashboard; optional audience if the token carries one
KINDE_ISSUER_URL=https://your-app.kinde.com
KINDE_AUDIENCE=

# Ollama Cloud (ChatOllama, base URL https://ollama.com)
OLLAMA_API_KEY=

# n8n instance — only needed for n8n-mcp's 16 management tools (core tools work without it)
N8N_API_URL=
N8N_API_KEY=

# CORS — comma-separated origins. If the Next.js app proxies through its own API routes,
# CORS is a non-issue; keep for direct dev access.
CORS_ORIGINS=http://localhost:3000

# LangSmith tracing — off by default in prod
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=botchain-ai