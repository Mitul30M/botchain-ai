# BotChain AI backend — copy to .env and fill in real values. Never commit .env.
# The backend MUST use the direct (unpooled) Neon URL, not the pooled one the frontend uses.

# Postgres (Neon, direct/unpooled)
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Kinde — issuer from the Kinde app dashboard; optional audience if the token carries one
KINDE_ISSUER_URL=https://your-app.kinde.com
KINDE_AUDIENCE=

# Ollama Cloud (ChatOllama, base URL https://ollama.com)
OLLAMA_API_KEY=

# Mistral
MISTRAL_API_KEY=
# Retries for transient provider failures — capacity 429s (code 3505) and
# transport errors (read timeouts, dropped connections).
MISTRAL_CAPACITY_RETRIES=3

# Token pricing -> messages.credits_cost (a DOLLAR value: 0.20 means $0.20 of spend).
# Known models are priced from the MODEL_PRICING table in src/app/services/pricing.py
# (USD per 1M tokens); these are the fallback rates for any model missing from it.
PRICING_UNKNOWN_INPUT_PER_MILLION=0.20
PRICING_UNKNOWN_OUTPUT_PER_MILLION=0.20
# Per-model override, e.g. to correct a stale table entry without a redeploy.
# Slug = uppercased model name, non-alphanumerics collapsed to "_".
# PRICING_INPUT_PER_MILLION_MINISTRAL_14B_LATEST=0.20
# PRICING_OUTPUT_PER_MILLION_MINISTRAL_14B_LATEST=0.20

# n8n instance — only needed for n8n-mcp's 16 management tools (core tools work without it)
N8N_API_URL=
N8N_API_KEY=

# CORS — comma-separated origins. If the Next.js app proxies through its own API routes,
# CORS is a non-issue; keep for direct dev access.
CORS_ORIGINS=http://localhost:3000

# LangSmith tracing — off by default in prod
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=botchain-ai